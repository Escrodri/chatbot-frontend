# ==============================================================================
# FRONTEND — Variables de compilación (Vite)
# ==============================================================================
# Vite las reemplaza en tiempo de BUILD, no en tiempo de ejecución: si cambiás
# esta URL hay que volver a compilar y volver a desplegar.

# URL del backend.
#   - Desarrollo local: dejala vacía. El proxy de vite.config.js manda /api y
#     /health a http://localhost:3000.
#   - Producción (frontend en Cloudflare, backend en Render): la URL del servicio,
#     sin barra final. Por ejemplo:
#     VITE_API_URL=https://chatbot-backend.onrender.com
VITE_API_URL=
